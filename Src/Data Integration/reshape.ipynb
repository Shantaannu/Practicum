    "\n",
    "def reshape_wide_to_long(df, metric_name):\n",
    "    \n",
    "    df_long = df.melt(\n",
    "        id_vars=[\"Date\"],\n",
    "        var_name=\"player_name\",\n",
    "        value_name=metric_name\n",
    "    )\n",
    "    \n",
    "    return df_long"
   ]
